# Development only; no provider keys required with DEMO_MODE=true.
APP_ENV=development
DEMO_MODE=true
DEFAULT_MODEL=gpt-6-luna
OPENAI_API_KEY=
TAVILY_API_KEY=
WOLFRAM_ALPHA_APPID=
HOST=127.0.0.1
PORT=8000
# Built frontend directory served same-origin (the image sets /app/static). Leave empty for
# an API-only process; it must contain index.html or startup fails.
STATIC_DIR=
MAX_MODEL_CALLS=8
MAX_TOOL_CALLS=12
RUN_TIMEOUT_S=120
MAX_OUTPUT_TOKENS=4096
MAX_TOOL_INPUT_CHARS=400
MAX_TOOL_OUTPUT_CHARS=6000
MAX_PARALLEL_TOOL_CALLS=3
MAX_CONTEXT_TOKENS=24000
MAX_RUN_INPUT_TOKENS=120000
# Optional for demo; required by the live application. Local compose only:
# DATABASE_URL=postgresql://research_dev:local-development-only@127.0.0.1:54329/research_agent
THREAD_RETENTION_DAYS=30
ANON_THREAD_TTL_HOURS=24
EMPTY_THREAD_TTL_HOURS=1
# In-process retention cleanup (M3b). Minutes between passes; 0 disables the scheduler.
# Only one process runs a pass at a time (PostgreSQL advisory lock), and the manual
# `research-agent-cleanup` command takes the same lock.
CLEANUP_INTERVAL_MINUTES=15

# Identity (M4a). Browser-facing origin of the app; unsafe requests must come from it.
# https:// switches cookies to Secure + __Host- prefix.
PUBLIC_BASE_URL=http://127.0.0.1:5173
# At least 32 characters. Empty in development uses a process-local key (sessions
# do not survive restarts). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# GitHub OAuth App; leave both empty to hide sign-in. Callback URL to register:
# <PUBLIC_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
USER_SESSION_IDLE_DAYS=7
# Abuse limits (M5a). Shared PostgreSQL fixed-window counters; a demo process without a
# database is not limited. Proxy headers are ignored unless this instance sits behind a
# verified ingress that sets them (Fly.io sets Fly-Client-IP). Re-verify before deployment.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ANON_SESSION_PER_HOUR=30
RATE_LIMIT_RESEARCH_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_HOUR=10
# Daily quotas (M5b). Weighted units per UTC day; anonymous callers are limited per
# session AND per hashed address, so clearing cookies does not reset the allowance.
# Weights come from the model catalog; anonymous callers may use only Luna.
QUOTA_ANON_DAILY=3
QUOTA_USER_DAILY=25

# Turnstile (M5b-2). Leave both empty to disable anonymous verification. Local testing may
# use Cloudflare's public always-pass keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Production readiness rejects test secrets.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFIED_MINUTES=60
RATE_LIMIT_TURNSTILE_PER_HOUR=30

# Budget and concurrency (M5c). Local conservative estimates, not a provider billing
# guarantee: reservations are the worst-case call cost and cover one SDK retry. A tool
# with no price in models.toml is never offered in live mode.
GLOBAL_DAILY_BUDGET_USD=5
BUDGET_RESERVATION_TTL_MINUTES=10
MAX_ACTIVE_RUNS=20
MAX_ACTIVE_RUNS_PER_PRINCIPAL=2
